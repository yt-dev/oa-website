---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import { localeTags, STORAGE_KEY, type Lang } from "../i18n/ui";
import type { Dictionary } from "../i18n";

interface Props {
	lang: Lang;
	t: Dictionary;
	/** Optional page-specific title override */
	title?: string;
	description?: string;
	/** Path without locale, e.g. "" or "privacy" */
	path?: string;
	/** Preload the LCP image for this page */
	preloadImage?: string;
}

const {
	lang,
	t,
	title = t.meta.title,
	description = t.meta.description,
	path = "",
	preloadImage,
} = Astro.props;

const localeTag = localeTags[lang];
---

<!doctype html>
<html lang={localeTag}>
	<head>
		<Seo
			lang={lang}
			title={title}
			description={description}
			ogImageAlt={t.meta.ogImageAlt}
			path={path}
			keywords={t.meta.keywords}
			featureNames={t.features.items.map((i) => i.title)}
		/>
		{preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="min-h-dvh flex flex-col">
		<script is:inline define:vars={{ lang, storageKey: STORAGE_KEY }}>
			try {
				localStorage.setItem(storageKey, lang);
			} catch (e) {}
		</script>
		<slot />
	</body>
</html>
