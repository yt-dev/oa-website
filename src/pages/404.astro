---
import "../styles/global.css";
import { languages, locales, pathForLang } from "../i18n/ui";
import { BRAND_NAME, THEME_COLOR } from "../lib/seo";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, follow" />
		<meta name="theme-color" content={THEME_COLOR} />
		<title>404 — {BRAND_NAME}</title>
		<meta name="description" content="This page does not exist." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
	</head>
	<body class="min-h-dvh bg-slate-50 font-sans text-slate-900 antialiased">
		<main class="flex min-h-dvh flex-col items-center justify-center px-6 py-16 text-center">
			<a href="/" class="flex items-center gap-2.5">
				<span
					class="flex h-9 w-9 items-center justify-center rounded-xl bg-linear-to-br from-indigo-500 to-violet-600 text-sm font-bold text-white shadow-md shadow-indigo-500/25"
				>
					301
				</span>
				<span class="text-base font-semibold tracking-tight">{BRAND_NAME}</span>
			</a>
			<p class="mt-10 font-mono text-sm font-semibold text-indigo-600">404</p>
			<h1 class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-4xl">
				Page not found
			</h1>
			<p class="mt-3 max-w-md text-pretty text-sm leading-relaxed text-slate-600">
				页面未找到 · ページが見つかりません
			</p>
			<ul class="mt-8 flex flex-wrap items-center justify-center gap-3">
				{
					locales.map((l) => (
						<li>
							<a
								href={pathForLang(l)}
								class="inline-flex rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-600"
							>
								{languages[l]}
							</a>
						</li>
					))
				}
			</ul>
		</main>
	</body>
</html>
