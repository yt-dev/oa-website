---
import Seo from "../components/Seo.astro";
import { getDictionary } from "../i18n";
import { languages, locales, pathForLang } from "../i18n/ui";

const t = getDictionary("en");
---

<!doctype html>
<html lang="en">
	<head>
		<Seo
			lang="en"
			title={t.meta.title}
			description={t.meta.description}
			ogImageAlt={t.meta.ogImageAlt}
			keywords={t.meta.keywords}
			robots="noindex, follow, max-image-preview:large"
			jsonLd={false}
		/>
		<script is:inline>
			(function () {
				var locales = ["en", "zh", "ja"];
				var fallback = "zh";
				var key = "oa.locale";
				function normalize(value) {
					if (!value) return fallback;
					var base = String(value).split("-")[0].toLowerCase();
					return locales.indexOf(base) !== -1 ? base : fallback;
				}
				function detect() {
					try {
						var stored = localStorage.getItem(key);
						if (stored) return normalize(stored);
					} catch (e) {}
					if (typeof navigator !== "undefined" && navigator.language) {
						return normalize(navigator.language);
					}
					return fallback;
				}
				var lang = detect();
				try {
					localStorage.setItem(key, lang);
				} catch (e) {}
				location.replace("/" + lang + "/");
			})();
		</script>
	</head>
	<body>
		<noscript>
			<main style="font-family:system-ui,sans-serif;max-width:40rem;margin:20vh auto;padding:1.5rem;text-align:center">
				<p>301 OA</p>
				<p>
					{
						locales.map((l, i) => (
							<>
								{i > 0 && " · "}
								<a href={pathForLang(l)}>{languages[l]}</a>
							</>
						))
					}
				</p>
			</main>
		</noscript>
	</body>
</html>
