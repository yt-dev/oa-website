---
import type { Dictionary } from "../i18n";
import type { Lang } from "../i18n/ui";
import { pathForLang } from "../i18n/ui";

interface Props {
  lang: Lang;
  t: Dictionary;
}

const { lang, t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="container-max section-pad py-14">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-xl bg-linear-to-br from-indigo-500 to-violet-600 text-sm font-bold text-white"
          >
            301
          </span>
          <span class="font-semibold text-slate-900">OA</span>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-slate-600">
          {t.footer.tagline}
        </p>
        <p class="mt-2 text-xs text-slate-400">{t.footer.builtFor}</p>
      </div>

      <div>
        <p
          class="text-xs font-semibold uppercase tracking-wider text-slate-500"
        >
          {t.footer.product}
        </p>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li>
            <a class="hover:text-indigo-600" href="#features"
              >{t.nav.features}</a
            >
          </li>
          <li>
            <a class="hover:text-indigo-600" href="#organizations"
              >{t.nav.forSchools}</a
            >
          </li>
          <li>
            <a class="hover:text-indigo-600" href="#security"
              >{t.nav.security}</a
            >
          </li>
          <li>
            <a class="hover:text-indigo-600" href="#gallery">{t.nav.gallery}</a>
          </li>
        </ul>
      </div>

      <div>
        <p
          class="text-xs font-semibold uppercase tracking-wider text-slate-500"
        >
          {t.footer.resources}
        </p>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li>
            <a class="hover:text-indigo-600" href={pathForLang(lang)}
              >{t.nav.home}</a
            >
          </li>
          <!-- <li>
            <span class="text-slate-400">{t.footer.note}</span>
          </li> -->
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-slate-200 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} 301 OA. {t.footer.rights}</p>
      <p>{t.footer.privacy}</p>
    </div>
  </div>
</footer>
