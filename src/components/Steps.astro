---
import type { Dictionary } from "../i18n";

interface Props {
	t: Dictionary;
}

const { t } = Astro.props;
---

<section id="steps" class="scroll-mt-20 bg-white py-20 sm:py-28">
	<div class="container-max section-pad">
		<div class="mx-auto max-w-2xl text-center">
			<h2 class="text-balance text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
				{t.steps.title}
			</h2>
		</div>

		<ol class="mx-auto mt-14 grid max-w-5xl gap-6 md:grid-cols-3">
			{
				t.steps.items.map((item) => (
					<li class="relative rounded-2xl border border-slate-200 bg-slate-50/50 p-6">
						<span class="font-mono text-3xl font-bold text-indigo-200">{item.step}</span>
						<h3 class="mt-3 text-lg font-semibold text-slate-900">{item.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-600">{item.body}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
