---
import type { Dictionary } from "../i18n";
import ImageSlot from "./ImageSlot.astro";

interface Props {
	t: Dictionary;
}

const { t } = Astro.props;
---

<section class="relative overflow-hidden mesh-bg text-white">
	<div
		class="pointer-events-none absolute inset-0 opacity-30 hero-grid"
		aria-hidden="true"
	>
	</div>
	<style>
		.hero-grid {
			background-image: radial-gradient(
				rgba(255, 255, 255, 0.08) 1px,
				transparent 1px
			);
			background-size: 24px 24px;
		}
	</style>

	<div class="container-max section-pad relative pb-20 pt-16 sm:pb-28 sm:pt-20 lg:pt-24">
		<div class="mx-auto max-w-3xl text-center">
			<span
				class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-medium text-indigo-100 backdrop-blur"
			>
				<span class="h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]"
				></span>
				{t.hero.badge}
			</span>

			<h1
				class="mt-6 text-balance text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
			>
				{t.hero.title}
				<span
					class="bg-gradient-to-r from-indigo-200 via-sky-200 to-violet-200 bg-clip-text text-transparent"
				>
					{t.hero.titleAccent}
				</span>
			</h1>

			<p
				class="mx-auto mt-6 max-w-2xl text-pretty text-base leading-relaxed text-slate-300 sm:text-lg"
			>
				{t.hero.subtitle}
			</p>

			<div class="mt-9 flex flex-wrap items-center justify-center gap-3">
				<a
					href="#features"
					class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-900 shadow-lg shadow-black/20 transition hover:bg-indigo-50"
				>
					{t.hero.primaryCta}
				</a>
				<a
					href="#steps"
					class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/5 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/10"
				>
					{t.hero.secondaryCta}
				</a>
			</div>
		</div>

		<div class="mx-auto mt-14 max-w-5xl">
			<div
				class="rounded-2xl border border-white/10 bg-white/5 p-2 shadow-2xl shadow-black/40 backdrop-blur sm:p-3"
			>
				<ImageSlot
					src="/images/hero-console.webp"
					alt={t.showcase.slots[0].label}
					label={t.showcase.slots[0].label}
					hint={t.showcase.slots[0].hint}
					aspect="video"
					priority
					class="border-0 shadow-none ring-0"
				/>
			</div>
		</div>

		<dl
			class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-3"
		>
			{
				[
					{ v: t.hero.stat1Value, l: t.hero.stat1Label },
					{ v: t.hero.stat2Value, l: t.hero.stat2Label },
					{ v: t.hero.stat3Value, l: t.hero.stat3Label },
				].map((s) => (
					<div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-4 text-center backdrop-blur">
						<dt class="text-sm font-semibold text-white">{s.v}</dt>
						<dd class="mt-1 text-xs text-slate-400">{s.l}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
